# Byt port om 3000 redan används
PORT=3000
NODE_ENV=development
# Lägg eventuella framtida AI-nycklar enbart i .env, aldrig i frontend.
# AI_API_KEY=

# Frivilligt lokalt. På Vercel krävs PostgreSQL för konton och historik.
# DATABASE_URL=

# Frivilligt. Lägg dessa i Vercels Production-miljö för att aktivera kontomejl.
# RESEND_API_KEY=
# MITTCSN_EMAIL_FROM=
# MITTCSN_BASE_URL=

# EmailJS. Behåll MITTCSN_BASE_URL ovan som sidans publika HTTPS-adress.
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=

# Frivilligt för AI-svar i guiden. Guidesvar fungerar utan nyckel.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4.1-mini
